# -----------------------------------------------------------------------------
# Clean Release Runtime Configuration
# -----------------------------------------------------------------------------
# The release/runtime scripts load configuration from .env via python-dotenv.
# For local development, the direct *_URL values are the clearest option.
# For Docker Compose or service discovery, use SERVICES_HOST + *_SERVICE + *_PORT.


# -----------------------------------------------------------------------------
# API Wrapper / Session Security
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-32-character-secret
UID_SECRET_KEY=replace-with-a-uid-secret


# -----------------------------------------------------------------------------
# Main Agent Runtime Flags
# -----------------------------------------------------------------------------
MACHINE_ID=local-agent
EXPERIMENT_CONFIG=clean-release
CC_ENABLED=true
ADAPTATION_ENABLED=true
RAW_GPT_MODE=false
PROFILE_MODE=high
RECOMMENDATION_TIMING=late


# -----------------------------------------------------------------------------
# Direct Service URLs - recommended for local runs
# -----------------------------------------------------------------------------
# These are used by the API wrapper and by MessageHandler when present.
AGENT_URL=http://localhost:8765
LOGGER_URL=http://localhost:5030
PROFILER_URL=http://localhost:5003
RECOMMENDER_URL=http://localhost:5004
ANONYMIZER_URL=http://localhost:8000
ADAPTER_URL=http://localhost:5010
DYNAMODB_URL=http://localhost:5002


# -----------------------------------------------------------------------------
# Composed Service URLs - useful for Docker/service-name deployments
# -----------------------------------------------------------------------------
# Example:
#   SERVICES_HOST=http://
#   AGENT_SERVICE=agent-service
#   AGENT_PORT=8765
# builds:
#   http://agent-service:8765
SERVICES_HOST=http://

AGENT_SERVICE=agent-service
LOGGER_SERVICE=logger-service
PROFILER_SERVICE=profiler-service
RECOMMENDER_SERVICE=recommender-service
ANONYMIZER_SERVICE=anonymizer-service
ADAPTER_SERVICE=adapter-service
DYNAMODB_SERVICE=dynamodb-service

AGENT_PORT=8765
LOGGER_PORT=5030
PROFILER_PORT=5003
RECOMMENDER_PORT=5004
ANONYMIZER_PORT=8000
ADAPTER_PORT=5010
DYNAMODB_PORT=5002


# -----------------------------------------------------------------------------
# Azure OpenAI Configuration
# -----------------------------------------------------------------------------
# Used by LangChain/AzureChatOpenAI. The model/deployment names below show the
# model family used in the experiments; replace with your own Azure deployment.
OPENAI_API_TYPE=azure
OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-key
MODEL_NAME=gpt-4o
DEPLOYMENT_NAME=gpt4o
TEMPERATURE=0.5
STREAMING=false


# -----------------------------------------------------------------------------
# LangChain / Tracing
# -----------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=replace-with-your-langchain-key
LANGCHAIN_PROJECT=it-agent-clean-release


# -----------------------------------------------------------------------------
# AWS / Optional External Storage
# -----------------------------------------------------------------------------
# Required only if you replace the profile/logger adapters with AWS-backed
# implementations, or if ClueCollector loads its server config from S3.
AWS_ACCESS_KEY_ID=replace-with-your-access-key
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=replace-with-your-bucket
S3_CONFIG_KEY=machineConfig.json


# -----------------------------------------------------------------------------
# ClueCollector Client Configuration
# -----------------------------------------------------------------------------
# Local config mode reads ClueCollector/src/machineConfig.example.json.
# S3 config mode sets USE_LOCAL_CONFIG=false and uses S3_CONFIG_KEY above.
USE_LOCAL_CONFIG=true
LOCAL_CONFIG_PATH=machineConfig.example.json
LOCAL_CC_CLIENT_ID=test_cc
CC_CLIENT_ID=


# -----------------------------------------------------------------------------
# Agent-Service Bridge Configuration
# -----------------------------------------------------------------------------
# agent_service/src/sia_server.py listens on this host/port. The Dockerfile
# exposes the same port.
AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=8765


# -----------------------------------------------------------------------------
# Experiment Web UI Configuration
# -----------------------------------------------------------------------------
# web_ui also includes its own .env.example with the same UI-specific keys.
REACT_APP_UI_TEST_MODE=true
REACT_APP_ENABLE_AUTH=false
REACT_APP_COGNITO_USER_POOL_ID=
REACT_APP_COGNITO_USER_POOL_CLIENT_ID=
REACT_APP_COGNITO_IDENTITY_POOL_ID=
REACT_APP_SESSION_SIGNING_SECRET=replace-with-example-session-secret


# -----------------------------------------------------------------------------
# Python Runtime
# -----------------------------------------------------------------------------
PYTHONUNBUFFERED=1
KMP_DUPLICATE_LIB_OK=TRUE
