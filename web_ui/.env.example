# React experiment UI configuration

# Set to true to exercise the UI without real agent-service endpoints.
REACT_APP_UI_TEST_MODE=true

# Set to false for a local UI preview without Cognito.
REACT_APP_ENABLE_AUTH=false

# Replace these with your authentication provider details if using Cognito.
REACT_APP_COGNITO_USER_POOL_ID=
REACT_APP_COGNITO_USER_POOL_CLIENT_ID=
REACT_APP_COGNITO_IDENTITY_POOL_ID=

# Example secret used only to mirror the original session-init handshake.
# In production, avoid placing signing secrets in browser code.
REACT_APP_SESSION_SIGNING_SECRET=replace-with-example-session-secret
